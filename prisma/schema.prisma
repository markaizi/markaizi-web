// markaizi ajans iş-takip platformu — veritabanı şeması
// Plan: ~/.claude/plans/crispy-fluttering-treehouse.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — uygulama çalışma zamanı
  directUrl = env("DIRECT_URL")   // direct — migration'lar için
}

// ── Enumlar ──────────────────────────────────────────────
enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum InvoiceStatus {
  ODENDI
  BEKLIYOR
  GUNU_GELMEDI
}

enum BillingPeriod {
  HAFTALIK
  AYLIK
}

enum ContentStatus {
  PLANLANDI
  DUZENLENIYOR
  HAZIR
  YAYINLANDI
}

enum UpdateKind {
  AJANS
  WEBSITE
}

enum RequestStatus {
  BEKLIYOR
  YAPILDI
}

enum ReportPlatform {
  META
  GOOGLE
  WEBSITE
}

enum WorkflowPriority {
  DUSUK
  ORTA
  YUKSEK
}

// ── Modeller ─────────────────────────────────────────────
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String? @unique
  passwordHash String
  role         Role    @default(CLIENT)
  name         String
  active       Boolean @default(true)

  // Sadece role=CLIENT için bağlı firma
  clientId String?
  client   Client? @relation("ClientUsers", fields: [clientId], references: [id], onDelete: SetNull)

  // Müşteri/çalışana not yazma yetkisi (admin her zaman yazar)
  canWriteNotes Boolean @default(false)

  // İş kayıtları — sadece EMPLOYEE için anlamlı. Ödeme günü (ayın kaçı, 1-31) admin
  // tarafından girilir; iş kaydı dönem/arşiv sınırlarını hesaplamak için kullanılır.
  paymentDay Int?

  // İş Akışı (kanban) yetkileri — sadece EMPLOYEE için anlamlı, ADMIN her zaman tam erişir.
  // Kart açma/düzenleme ile sürükleme bilinçli olarak ayrı tutuluyor: bir çalışana sadece
  // "kartları sürükle" (drag-only) ya da sadece "kart oluştur/düzenle" (sürüklemeden) yetkisi
  // verilebilir. Açıklama (description) alanı ise bu ikisinden bağımsız — pano erişimi olan
  // herkes girdiği bir kartın açıklamasına not ekleyebilir; revize notu ise ayrı, varsayılan
  // kapalı bir yetkiyle korunur (sadece admin'in açıkça izin verdiği kişiler yazabilir).
  workflowAccess               Boolean @default(true)  // panoyu hiç görebilir mi
  workflowCanCreateCards       Boolean @default(true)  // kart oluşturur, başlık/öncelik/tarih/atanan/firma düzenler, kendi kartını siler
  workflowCanDragCards         Boolean @default(true)  // kartları sütunlar arası sürükleyip taşıyabilir
  workflowCanWriteRevisionNote Boolean @default(false) // kartlara revize notu ekleyebilir/düzenleyebilir
  workflowCanDeleteAnyCard     Boolean @default(false) // başkasının kartını da silebilir
  workflowCanManageColumns     Boolean @default(false) // sütun ekle/yeniden adlandır/sil

  assignments     Assignment[]
  authoredUpdates Update[]      @relation("UpdateAuthor")
  authoredContent ContentItem[] @relation("ContentAssignee")
  authoredNotes   Note[]        @relation("NoteAuthor")
  noteReads       NoteRead[]
  authoredAdReports AdReport[]  @relation("AdReportAuthor")
  workLogs          WorkLog[]

  workflowCardsAssigned WorkflowCard[] @relation("WorkflowAssignee")
  workflowCardsCreated  WorkflowCard[] @relation("WorkflowCreator")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  invoiceNote String?
  active      Boolean @default(true)

  // İletişim bilgileri — hepsi opsiyonel
  contactPerson String?
  contactEmail  String?
  contactPhone  String?

  // Ödeme planı — doluysa, bir fatura "Ödendi" yapıldığında sonraki dönem
  // faturası otomatik oluşturulur (GUNU_GELMEDI durumuyla).
  billingAmount String?
  billingPeriod BillingPeriod?

  // Günlük reklam harcaması — müşteri kendi panelinde görür, admin/çalışan girer
  dailyMetaSpend   String?
  dailyGoogleSpend String?

  updates       Update[]
  contentItems  ContentItem[]
  invoices      Invoice[]
  notes         Note[]
  assignments   Assignment[]
  users         User[]         @relation("ClientUsers")
  workflowCards WorkflowCard[]
  adReports     AdReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id       String @id @default(cuid())
  userId   String // EMPLOYEE
  clientId String

  // Her section için: false+false=Yok, true+false=Görüntüle, true+true=Düzenle
  canViewContent     Boolean @default(true)
  canManageContent   Boolean @default(true)
  canViewUpdates     Boolean @default(true)
  canManageUpdates   Boolean @default(true)
  canViewInvoices    Boolean @default(false)
  canManageInvoices  Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model ContentItem {
  id            String        @id @default(cuid())
  clientId      String
  title         String
  description   String?
  scheduledDate DateTime
  status        ContentStatus @default(PLANLANDI)
  assigneeId    String?
  completedAt   DateTime?
  publishedAt   DateTime?

  // İş Akışı'ndaki bir karttan otomatik oluşturulduysa bağlantısı (opsiyonel).
  // Kart silinirse bu alan null'a düşer, içerik kaydı SİLİNMEZ (bkz. onDelete: SetNull).
  workflowCardId String? @unique

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workflowCard WorkflowCard? @relation(fields: [workflowCardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Update {
  id       String     @id @default(cuid())
  clientId String
  kind     UpdateKind @default(AJANS)
  text     String
  date     DateTime
  authorId String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Invoice {
  id       String        @id @default(cuid())
  clientId String
  period   String
  amount   String
  status   InvoiceStatus @default(BEKLIYOR)
  dueDate  DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Müşteri İstekleri — sadece CLIENT yazar, ajans görüntüleyip durumunu işaretler.
model Note {
  id         String        @id @default(cuid())
  clientId   String
  authorId   String?
  authorRole Role
  text       String
  status     RequestStatus @default(BEKLIYOR)

  client Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?      @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reads  NoteRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NoteRead {
  userId String
  noteId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([userId, noteId])
}

// ── İş Akışı (Trello tarzı ajans-içi kanban) ──────────────
model WorkflowColumn {
  id        String @id @default(cuid())
  title     String
  sortOrder Int    @default(0)

  // true ise: bir kart bu sütuna taşındığında, atanan çalışana otomatik iş
  // kaydı (WorkLog) oluşturulur. Admin bunu istediği sütun(lar)a işaretleyebilir
  // (örn. "Kontrol" veya "Tamamlandı") — sütun adları serbest metin olduğu için
  // isme göre eşleştirme yapılmıyor, admin açıkça işaretliyor.
  triggersWorkLog Boolean @default(false)

  // true ise: bu sütuna taşınan kartlarda, kart bir firmaya bağlıysa "İçerik
  // Takvimine Ekle" seçeneği görünür — yayınlanma tarihi girilip onaylanınca
  // o firmanın İçerik Takvimi'ne otomatik bir ContentItem eklenir.
  triggersContentItem Boolean @default(false)

  // true ise: bir kart bu sütuna taşındığında admin'e e-posta bildirimi gider —
  // panele girmeden "kart kontrole geldi" gibi olaylardan haberdar olmak için.
  notifyOnEntry Boolean @default(false)

  // true ise: bu sütuna sadece ADMIN kart taşıyabilir/kart ekleyebilir; sütundaki
  // kartlara (taşıma, düzenleme, silme) ADMIN dışında kimse dokunamaz — kart o
  // sütundayken çalışanlar için salt-okunur ve sürüklenemez hale gelir.
  adminOnly Boolean @default(false)

  cards WorkflowCard[]

  createdAt DateTime @default(now())
}

model WorkflowCard {
  id           String           @id @default(cuid())
  columnId     String
  title        String
  description  String?
  revisionNote String? // admin'in "revize istiyorum" notu — kart üzerinde vurgulu gösterilir
  priority     WorkflowPriority @default(ORTA)
  dueDate      DateTime?
  sortOrder    Int              @default(0)

  // Panoyu sadeleştirmek için admin arşivleyebilir (silmeden) — arşivli kartlar
  // board GET'inde dönmez. Silme ayrı bir işlemdir ve bağlı iş kaydını etkilemez.
  archivedAt DateTime?

  clientId   String?
  assigneeId String?
  creatorId  String

  column   WorkflowColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignee User?          @relation("WorkflowAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User           @relation("WorkflowCreator", fields: [creatorId], references: [id])
  workLog  WorkLog?
  contentItem ContentItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Aylık Reklam Raporları ─────────────────────────────────
model AdReport {
  id          String         @id @default(cuid())
  clientId    String
  platform    ReportPlatform
  month       String // "Temmuz 2026"
  spend       String?
  impressions String?
  clicks      String?
  summary     String?
  authorId    String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation("AdReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime @default(now())
}

// ── İş Kayıtları — çalışan (freelancer) yaptığı işi günlük olarak girer,
// admin karşısına ücret yazar. Ödeme günü User.paymentDay'de tutulur. ──
model WorkLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  description String
  amount      String? // admin doldurur, örn "250 ₺"

  // İş Akışı'ndaki bir karttan otomatik oluşturulduysa bağlantısı (opsiyonel).
  // Kart silinirse bu alan null'a düşer, iş kaydı SİLİNMEZ (bkz. onDelete: SetNull) —
  // pano temizliği ile ücret/ödeme kaydı birbirinden bağımsız kalır.
  workflowCardId String? @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowCard WorkflowCard? @relation(fields: [workflowCardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}
