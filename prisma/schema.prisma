// markaizi ajans iş-takip platformu — veritabanı şeması
// Plan: ~/.claude/plans/crispy-fluttering-treehouse.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — uygulama çalışma zamanı
  directUrl = env("DIRECT_URL")   // direct — migration'lar için
}

// ── Enumlar ──────────────────────────────────────────────
enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum Platform {
  META
  GOOGLE
  TIKTOK
}

enum CampaignStatus {
  AKTIF
  DURAKLATILDI
  TAMAMLANDI
  ODEME_HATASI
}

enum InvoiceStatus {
  ODENDI
  BEKLIYOR
  GUNU_GELMEDI
}

enum ContentStatus {
  PLANLANDI
  DUZENLENIYOR
  HAZIR
  YAYINLANDI
}

enum UpdateKind {
  AJANS
  WEBSITE
}

// ICERIK = sadece ajans-içi (admin + atanmış çalışan)
// PAYLASIMLI = müşteri de görür
enum NoteVisibility {
  ICERIK
  PAYLASIMLI
}

// ── Modeller ─────────────────────────────────────────────
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String? @unique
  passwordHash String
  role         Role    @default(CLIENT)
  name         String
  active       Boolean @default(true)

  // Sadece role=CLIENT için bağlı firma
  clientId String?
  client   Client? @relation("ClientUsers", fields: [clientId], references: [id], onDelete: SetNull)

  // Müşteri/çalışana not yazma yetkisi (admin her zaman yazar)
  canWriteNotes Boolean @default(false)

  assignments     Assignment[]
  authoredUpdates Update[]      @relation("UpdateAuthor")
  authoredContent ContentItem[] @relation("ContentAssignee")
  authoredNotes   Note[]        @relation("NoteAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  package     String
  invoiceNote String?
  active      Boolean @default(true)

  campaigns    Campaign[]
  updates      Update[]
  contentItems ContentItem[]
  invoices     Invoice[]
  notes        Note[]
  assignments  Assignment[]
  users        User[]        @relation("ClientUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id       String @id @default(cuid())
  userId   String // EMPLOYEE
  clientId String

  // Hangi sekmeleri görebilir / yönetebilir
  canViewCampaigns Boolean @default(true)
  canManageContent Boolean @default(true)
  canManageUpdates Boolean @default(true)
  canViewInvoices  Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model Campaign {
  id          String         @id @default(cuid())
  clientId    String
  platform    Platform
  name        String
  startDate   DateTime?
  endDate     DateTime?
  ongoing     Boolean        @default(false)
  dailyBudget String // "200 ₺/gün"
  status      CampaignStatus @default(AKTIF)
  sortOrder   Int            @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id            String        @id @default(cuid())
  clientId      String
  title         String
  description   String?
  scheduledDate DateTime
  status        ContentStatus @default(PLANLANDI)
  assigneeId    String?
  completedAt   DateTime?
  publishedAt   DateTime?

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee User?  @relation("ContentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Update {
  id       String     @id @default(cuid())
  clientId String
  kind     UpdateKind @default(AJANS)
  text     String
  date     DateTime
  authorId String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Invoice {
  id       String        @id @default(cuid())
  clientId String
  period   String
  amount   String
  status   InvoiceStatus @default(BEKLIYOR)
  dueDate  DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Note {
  id         String         @id @default(cuid())
  clientId   String
  authorId   String?
  authorRole Role
  text       String
  visibility NoteVisibility @default(ICERIK)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author User?  @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
