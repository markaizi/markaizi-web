#!/usr/bin/env node
// mkz — markaizi panel komut aracı (Telegram + Claude botu için). Tek işi: /api/agent ucunu çağırmak.
//   mkz <islem> ['<json-argumanlar>']        ör:  mkz ozet
//                                                  mkz ziyaret_ekle '{"firma":"Örnek Firma","tarih":"2026-11-24T10:00"}'
// Ortam: MKZ_API (varsayılan https://markaizi.com.tr/api/agent), MKZ_TOKEN (zorunlu; ~/.mkz-env içinden okunur).
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const envFile = path.join(os.homedir(), ".mkz-env");
if (fs.existsSync(envFile)) {
  for (const line of fs.readFileSync(envFile, "utf8").split("\n")) {
    const m = line.match(/^\s*([A-Z_]+)\s*=\s*(.*?)\s*$/);
    if (m && !process.env[m[1]]) process.env[m[1]] = m[2].replace(/^["']|["']$/g, "");
  }
}

const [action, rawArgs] = process.argv.slice(2);
if (!action) { console.error("Kullanım: mkz <islem> ['<json>']"); process.exit(2); }
if (!process.env.MKZ_TOKEN) { console.error("MKZ_TOKEN tanımlı değil (~/.mkz-env)."); process.exit(2); }

let args = {};
if (rawArgs) {
  try { args = JSON.parse(rawArgs); } catch { console.error("Argümanlar geçerli JSON değil."); process.exit(2); }
}

fetch(process.env.MKZ_API || "https://markaizi.com.tr/api/agent", {
  method: "POST",
  headers: { "Content-Type": "application/json", Authorization: `Bearer ${process.env.MKZ_TOKEN}` },
  body: JSON.stringify({ action, args }),
  signal: AbortSignal.timeout(30000),
})
  .then(async (res) => {
    const text = await res.text();
    let json; try { json = JSON.parse(text); } catch { json = { error: `Sunucu yanıtı okunamadı (HTTP ${res.status}).` }; }
    if (!res.ok) { console.log(JSON.stringify({ hata: json.error ?? `HTTP ${res.status}`, ...(json.islemler ? { islemler: json.islemler } : {}) }, null, 1)); process.exit(1); }
    console.log(JSON.stringify(json.result, null, 1));
  })
  .catch((e) => { console.log(JSON.stringify({ hata: `Bağlantı kurulamadı: ${e.message}` })); process.exit(1); });
